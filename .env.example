# Copia este archivo como .env y cambia los valores antes de levantar los contenedores.
# El archivo .env NO se sube a GitHub.

# Base de datos MySQL
MYSQL_DATABASE=mercado_local
MYSQL_USER=mercado
MYSQL_PASSWORD=cambia_esta_contrasena
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena_root

# Django
DJANGO_SECRET_KEY=cambia_esta_clave_secreta_larga_y_aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (URL del backend vista desde el navegador)
VITE_BASE_API_URL=http://localhost:8000
VITE_LOCAL_STORAGE_ITEM_NAME=MERCADO_LOCAL_ACCESS_TOKEN
